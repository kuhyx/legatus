[configuration]

entry_symbol = "legatus_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

; One optimised build for editor and export (see gdextension/SConstruct).
linux.debug.x86_64 = "res://bin/liblegatus.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/liblegatus.linux.template_release.x86_64.so"
